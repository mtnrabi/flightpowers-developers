# Values live in Vercel project envs — never commit real values.

# RapidAPI key the live demo + free tools spend server-side.
# Only src/lib/demo/upstream.ts may read it. Never client-side, never logged.
FP_DEMO_KEY=

# Global daily ceiling on upstream demo calls (per warm instance). Default 400.
DAILY_BACKEND_CALL_BUDGET=400

# Per-visitor daily cap on upstream demo calls. Default 12.
DEMO_PER_IP_DAILY=12

# Canonical origin override (defaults to https://flightpowers.com).
NEXT_PUBLIC_SITE_URL=
